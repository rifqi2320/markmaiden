{
  "name": "markmaiden",
  "private": true,
  "version": "1.0.0",
  "packageManager": "pnpm@10.16.1",
  "scripts": {
    "build": "pnpm -r --if-present build",
    "dev": "pnpm -r --parallel --stream --filter @markmaiden/frontend --filter @markmaiden/backend dev",
    "lint": "pnpm -r --if-present lint",
    "start": "docker compose up --build"
  }
}
